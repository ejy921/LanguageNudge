{
  "name": "LanguageNudge",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": "images/logo/icon.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "oauth2": {
    "client_id": "GOOGLE_CLIENT_ID",
    "scopes": [
      "openid", "email", "profile"
    ]
  }
}